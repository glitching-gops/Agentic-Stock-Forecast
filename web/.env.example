# Base URL of the FastAPI backend on Render. Server-side only — this is never
# exposed to the browser, and no page fetches the API from client code.
API_BASE_URL=https://your-service.onrender.com

# Shared secret for POST /api/revalidate, which the daily GitHub Actions
# workflow calls after the pipeline finishes so the site refreshes on the data's
# cadence instead of waiting out the hourly ISR window.
REVALIDATE_SECRET=
