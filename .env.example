# ── LLM providers ─────────────────────────────────────────────────────────────
#
# TWO PROVIDERS, SPLIT BY WHICH RESOURCE EACH JOB SPENDS. Measured 2026-09-03:
#
#                       Groq free      OpenRouter free
#   requests / minute   30             20
#   requests / day      1,000          50 unfunded, 1,000 after a one-time $10
#   tokens / minute     8,000          none
#   tokens / day        200,000        none
#
# Groq caps TOKENS; OpenRouter caps REQUESTS and does not count tokens at all.
# So few-calls/long-prompts work (narrative, critic, regime) routes to
# OpenRouter and many-calls/short-prompts work (relevance filtering) routes to
# Groq. agents/llm.py holds the table and the reasoning.
GROQ_API_KEY=your_groq_key_here

# Optional. Without it every task falls back down its chain to Groq, which
# works — the routing table ends on Groq deliberately, because OpenRouter's
# free model lineup rotates. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Set this ONLY if you have purchased $10+ of OpenRouter credits, which raises
# the free-model cap from 50 requests/day to 1,000 permanently. It changes no
# behaviour — it is what preflight reports as the daily budget, so the log says
# something true about how much headroom the reasoning tier has. The tier needs
# ~17 calls/day (12 narratives + ~4 critic reviews + 1 regime read), which fits
# unfunded with 33 to spare.
# OPENROUTER_FUNDED=1

# API Configuration
API_BASE_URL=http://localhost:8000
ADMIN_API_KEY=admin_secret_key_here

# CORS — comma-separated origins allowed to call the API.
# The admin router can trigger a full pipeline run for the whole universe, so
# this is no longer a wildcard.
ALLOWED_ORIGINS=https://glitching-gops-zer0.streamlit.app,http://localhost:8501

# Database Configuration (Defaults to local SQLite)
# For production, use a PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/stock_forecast
DATABASE_URL=sqlite:///./stock_forecast.db

# Model Configuration
#
# LEFT COMMENTED OUT ON PURPOSE. agents/llm.py holds the default and the
# reasoning behind it; a value here silently overrides that, which is how this
# file came to pin openai/gpt-oss-20b long after that model had been measured
# running out of tokens partway through a run. Set it only to override
# deliberately, and read agents/llm.py first.
#
# The current default is openai/gpt-oss-120b (Groq free tier: 30 req/min,
# 1,000 req/day, 8k tokens/min, 200k tokens/day).
# GROQ_MODEL=openai/gpt-oss-120b

# How many stocks get an LLM-WRITTEN narrative per day; the rest get the
# deterministic rule-based one. 12 divides the 84-name frozen universe exactly,
# so every stock is written up once a week. See
# agents/forecasting_agent._narrative_sample.
# NARRATIVE_SAMPLE_SIZE=12

# GITHUB_TOKEN is no longer needed here. render_start.sh used to download a
# pre-trained models_store.zip via GitHub's Contents API on every cold start;
# that step is removed as of the Phase 0 rewrite (pipeline.model always
# retrains fresh, it never reads a cached joblib) and the flaky download was
# the direct cause of a deploy failure.

# Compute has moved off Render entirely (Lever 4). DATABASE_URL and
# GROQ_API_KEY above also need to be added as GITHUB REPOSITORY SECRETS
# (Settings -> Secrets and variables -> Actions), with the same values, so
# .github/workflows/daily-pipeline.yml and weekly-evaluation.yml can run the
# pipeline directly against Supabase. Render itself only serves reads and
# on-demand admin-triggered forecasts, and runs no scheduled compute.