# Local documentation — keep locally, do not push
CLAUDE.md
PLAN.md

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Database files — local SQLite only
*.db
*.sqlite
*.sqlite3

# Trained model artifacts
models/joblib/
models/lstm/
models/meta/
# Logs
logs/
*.log

# Scheduler lock
scheduler.lock

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build / dist
dist/
build/
*.egg-info/
# Optuna params
tuned_params/
tuned_params/*.json

# Development/Scratch
scratch/
 
# Scheduler lock file
*.lock
scheduler.lock

# Claude Code — machine-specific settings (interpreter paths, personal allowlist).
# .claude/settings.json, .claude/hooks/, .claude/agents/ and .claude/skills/
# ARE committed: they are project truths, not personal preference.
.claude/settings.local.json
*.doctor-backup

# Generated model packages (LoRA export, probe embedding caches, the Kaggle
# series package) — regenerable from tools/export_*_package.py and
# tools/run_probe.py, and large.
*.npz

# Scored comparison output. The measurement itself belongs in experiment_runs
# and in the commit message that reports it, which is how every earlier result
# here was recorded; a JSON checked in beside them would be a second copy that
# can disagree with the first.
p2_*.json
baselines_*.json

# Serena MCP server's per-project cache and memories — machine-local, and it
# re-derives itself from the source tree on demand.
.serena/
news_relevance_sample.json
news_relevance_subsample_idx.json

# Evidence-Grading Redesign, Stage 0 — generated run artifacts. The *.npz
# out-of-sample cache is already covered above; these are the report and the
# per-ticker table, regenerated by tools/run_evidence_grading.py. The findings
# live in docs/, not here.
stage0_report.txt
evidence_grades_v2.csv
stage0_addendum.txt
stage0_addendum.md
stage0_addendum.csv

# Stage 2a — the tuner-objective pilot's raw run artifacts. The findings live
# in docs/stage2a-findings.md, which quotes these tables inside the reasoning
# that makes them readable; a loose copy beside it is a second version that can
# disagree with the first.
stage2a_step_a.md
stage2a_step_b.md
stage2a_step_a.csv
stage2a_step_b.csv
stage2a_pilot.log

# Stage 2b — the pooled-model run artifacts. `pipeline/evidence_shrinkage.py`
# used to be ignored here, because Stage 2b borrowed it from an unmerged
# branch; Stage 0b MERGES that branch, so the module is tracked now and the
# ignore has been removed — leaving it would silently drop the fix.
panel_cache.parquet
stage2b_pooled_oos.npz
stage2b_report.md
stage2b_cells.csv
stage2b_panel.md
stage2b_run.log
stage2b_sweep.md
stage2b_sweep.csv
stage2b_sweep.log
stage2b_panel.log

# Stage 0b — the re-grade's own artifacts. The findings live in
# docs/stage0b-findings.md; a loose copy beside it is a second version that
# can disagree with the first.
stage0b_regrade.md
stage2a_pilot_oos.npz
stage2a_regrade.log

# Stage 0c — the closing run's own artifacts. The findings live in
# docs/stage0-closing.md, which is the single document this whole track hands
# to a reader; a loose copy beside it is a second version that can disagree.
stage0c_report.md
stage0c_report_block63.md
stage0c_run.log
stage0c_block_sensitivity.log
stage0c_live_gate.md
stage0c_null.log
stage0c_gate.log

# Stage 1, Pilot 1 — the reversal run's own artifacts. The held-out predictions
# (stage1_reversal_oos.npz) are covered by *.npz above; the findings live in
# docs/stage1-findings.md, not in these.
stage1_report.md
stage1_smoke.md
stage1_run.log
stage1_smoke.log

# graphify — the local knowledge-graph tool's output: graph.json, graph.html,
# GRAPH_REPORT.md and a content-addressed AST cache (12.5 MB, 175 files on
# 2026-09-11). Regenerated from the source tree by /graphify, and it records
# absolute local paths, so it is machine-local rather than project truth.
graphify-out/
